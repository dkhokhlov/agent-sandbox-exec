#!/bin/sh
# postinst: enable + start the daemon. agent-sandbox-execd creates the cgroup and loads
# the BPF-LSM program when it starts. Runs as root.
set -e

mkdir -p /etc/agent-sandbox-exec

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload
	systemctl enable agent-sandbox-execd.service
	systemctl start agent-sandbox-execd.service
fi

# Sanity hints for the admin.
echo "agent-sandbox-exec: daemon enabled. Add secret files to /etc/agent-sandbox-exec/denylist."
echo "agent-sandbox-exec: route agents through /usr/bin/agent-sandbox-exec."

exit 0
