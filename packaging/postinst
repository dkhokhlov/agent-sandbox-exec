#!/bin/sh
# postinst: enable + start the daemon. sandboxd creates/delegates the cgroup and
# loads the BPF-LSM program when it starts. Runs as root.
set -e

mkdir -p /etc/agent-sandbox

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	systemctl enable agent-sandbox.service || true
	systemctl start agent-sandbox.service || true
fi

# Sanity hints for the admin.
echo "agent-sandbox-exec: daemon enabled. Add secret files to /etc/agent-sandbox/denylist."
echo "agent-sandbox-exec: route agents through /usr/local/bin/agent-sandbox-exec."

exit 0
