#!/bin/sh
# postrm: on purge, disable the unit and clean up runtime state
# (delegated cgroup if empty, pinned BPF maps created by the daemon).
set -e

if [ "$1" = "purge" ]; then
	if [ -d /run/systemd/system ]; then
		systemctl disable agent-sandbox.service || true
		rm -f /etc/systemd/system/agent-sandbox.service 2>/dev/null || true
		systemctl daemon-reload || true
	fi
	rmdir /sys/fs/cgroup/agent-sandbox 2>/dev/null || true
	rm -f /sys/fs/bpf/deny_map /sys/fs/bpf/target_cgid_map 2>/dev/null || true
	# /etc/agent-sandbox/denylist is a conffile -> dpkg removes it on purge;
	# tidy the directory if empty.
	rmdir /etc/agent-sandbox 2>/dev/null || true
fi

exit 0
