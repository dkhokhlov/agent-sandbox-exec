[Unit]
Description=agent-sandbox-exec: BPF-LSM file-read denylist for CLI agents
Documentation=file:///usr/share/doc/agent-sandbox-exec/README.md
# Needs kernel BTF for CO-RE and cgroup v2.
ConditionPathIsDirectory=/sys/kernel/btf
ConditionPathIsDirectory=/sys/fs/cgroup

[Service]
Type=notify
ExecStart=/usr/sbin/agent-sandbox-execd
Restart=on-failure
RestartSec=1
# BPF historically needed memlock; harmless to set, avoids edge cases.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
